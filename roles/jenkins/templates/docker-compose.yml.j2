version: "3.8"

services:
  jenkins:
    build: .
    container_name: jenkins
    ports:
      - "{{ jenkins_http_port }}:8080"
    env_file:
      - .env
    environment:
      - CASC_JENKINS_CONFIG=/var/jenkins_home/casc
      - JAVA_OPTS=-Djenkins.install.runSetupWizard=false
    volumes:
      - jenkins_home:/var/jenkins_home
    restart: unless-stopped

volumes:
  jenkins_home:
